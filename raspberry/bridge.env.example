# Copiar a /etc/rotoformas-bridge.env, permisos 600. NO subir secretos.
BRIDGE_URL=https://script.google.com/macros/s/ID_DESPLIEGUE_PUBLICO/exec
RPI_BRIDGE_TOKEN=REEMPLAZAR_CON_TOKEN_ALEATORIO_DE_64_CARACTERES
SCALE_PORT=/dev/ttyUSB0
# Fase inicial: solo bascula. Las dos salidas requieren tambien permiso servidor.
ENABLE_PRINT=false
ENABLE_LASER=false
# Completar solo para futuras fases aprobadas; no hacen falta para la bascula.
# ZEBRA_CUPS_QUEUE=NOMBRE_COLA_VALIDADA
# LASER_HOST=HOST_VALIDADO_DEL_CONTROLADOR
# LASER_PORT=PUERTO_VALIDADO_DEL_CONTROLADOR
BRIDGE_DB=/var/lib/rotoformas-bridge/jobs.sqlite3
SYNC_INTERVAL_SECONDS=3
# ROTOFORMAS_LOGO_PNG=/opt/rotoformas-bridge/logo.png

