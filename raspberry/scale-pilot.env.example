# Plantilla sin secretos; guardar fuera de Git como /etc/rotoformas-scale-pilot.env
BRIDGE_URL=https://script.google.com/macros/s/ID_DESPLIEGUE_PLANTA_EXISTENTE/exec
RPI_BRIDGE_TOKEN=REEMPLAZAR_CON_TOKEN_HEXADECIMAL_PRIVADO_DE_64_CARACTERES
SCALE_PORT=/dev/serial/by-id/ENLACE_YA_VALIDADO
BRIDGE_DB=/var/lib/rotoformas-scale-pilot/jobs.sqlite3
SYNC_INTERVAL_SECONDS=3
ENABLE_PRINT=false
ENABLE_LASER=false
