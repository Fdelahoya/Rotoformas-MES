# Copiar a /etc/rotoformas-bridge.env, permisos 600. NO subir secretos.
BRIDGE_URL=https://script.google.com/macros/s/ID_DESPLIEGUE_PUBLICO/exec
RPI_BRIDGE_TOKEN=REEMPLAZAR_CON_TOKEN_ALEATORIO_DE_64_CARACTERES
SCALE_PORT=/dev/ttyUSB0
ZEBRA_CUPS_QUEUE=Zebra_ZT231_USB
LASER_HOST=192.168.0.30
LASER_PORT=8050
BRIDGE_DB=/var/lib/rotoformas-bridge/jobs.sqlite3
SYNC_INTERVAL_SECONDS=3
